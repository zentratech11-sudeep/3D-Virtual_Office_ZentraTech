# Contact form delivery (all optional).
#
# Where the browser POSTs enquiries. Leave empty to use the mailto hand-off
# (the UI then tells visitors to send the message from their email app; it
# never claims the message was delivered).
#   - Use "/api/contact" to send through this app's server route (needs CONTACT_WEBHOOK_URL).
#   - Or a form service URL that accepts JSON POSTs, e.g. https://formspree.io/f/xxxx
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Server-only. Used by /api/contact to forward validated enquiries (JSON POST)
# to Slack/Zapier/Make/your CRM. Never exposed to the browser.
CONTACT_WEBHOOK_URL=
