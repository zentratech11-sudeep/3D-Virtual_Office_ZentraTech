{
  "name": "corporate-virtual-office",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive, stylized isometric 3D corporate office campus built with Next.js and React Three Fiber.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
